#version 450 core

// Compute shader work group size
layout(local_size_x = 8, local_size_y = 8) in;

// Input game texture (read-only)
layout(binding = 0) uniform sampler2D u_input_texture;

// Output texture (write-only)
layout(binding = 1, rgba8) uniform image2D u_output_texture;

// Input game resolution
layout(location = 0) uniform vec2 u_input_size;
// Output screen resolution  
layout(location = 1) uniform vec2 u_output_size;

// Screen warp amounts (x=horizontal influence, y=vertical)
#define WARP_X (1.0 / 48.0)
#define WARP_Y (1.0 / 24.0)

void main() {
    // Get the pixel coordinates we're computing
    ivec2 pixel_coords = ivec2(gl_GlobalInvocationID.xy);
    
    // Skip if outside output bounds
    if (pixel_coords.x >= int(u_output_size.x) || pixel_coords.y >= int(u_output_size.y)) {
        return;
    }
    
    // Convert pixel coordinates to normalized UV [0,1]
    vec2 uv = (vec2(pixel_coords) + 0.5) / u_output_size;
    
    // Convert to [-1, 1] range for barrel warp
    vec2 pos = uv * 2.0 - 1.0;
    
    // Apply barrel warp distortion
    pos *= vec2(
        1.0 + (pos.y * pos.y) * WARP_X,
        1.0 + (pos.x * pos.x) * WARP_Y);
    
    // Convert back to [0, 1] UV space
    uv = pos * 0.5 + 0.5;
    
    // Black out areas outside valid texture bounds (warped edges)
    vec3 color = vec3(0.0);
    if (uv.x >= 0.0 && uv.x <= 1.0 && uv.y >= 0.0 && uv.y <= 1.0) {
        color = texture(u_input_texture, uv).rgb;
    }
    
    // Write to output
    imageStore(u_output_texture, pixel_coords, vec4(color, 1.0));
}
